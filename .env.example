# DeepSeek API (required)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Google Search Console (optional — for real traffic data in reports)
# Path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# PageSpeed Insights API (optional — for Lighthouse scores)
# Get your key at https://developers.google.com/speed/docs/insights/v5/get-started
PAGE_SPEED_API_KEY=your-pagespeed-api-key

# DataForSEO API (optional — for keyword research & related keywords)
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password
# Max keywords per query (default: 10)
DATAFORSEO_LIMIT=10
# Max GSC queries to enrich (default: 10)
DATAFORSEO_MAX_QUERIES=10
# LLM Mentions (citações por LLMs): keyword buscada junto ao domínio auditado (default: reulison)
DATAFORSEO_LLM_KEYWORD=reulison
# Max results per LLM Mentions query (default: 50)
DATAFORSEO_LLM_LIMIT=50
# Plataforma de IA: chat_gpt, google ou vazio para ambas (default: ambas)
DATAFORSEO_LLM_PLATFORM=
# Localização/idioma das buscas de IA (default: 2840 / en)
DATAFORSEO_LLM_LOCATION_CODE=2840
DATAFORSEO_LLM_LANGUAGE_CODE=en

# Optional: Data storage directory
SAC_DATA_DIR=./data

# Optional: DeepSeek model (default: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# Optional: Max pages to crawl (default: 1000)
MAX_CRAWL_PAGES=1000
